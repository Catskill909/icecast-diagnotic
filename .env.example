# ── SMTP Configuration ──────────────────────────────
# PREFER A SEND-ONLY CREDENTIAL over a mailbox password.
#
# A mailbox account's SMTP password — a Gmail app password, say — usually grants
# READ access to that mailbox as well as the ability to send. If it leaks, an
# attacker does not merely send mail as the station; they may read the station's
# mail. A transactional provider's API key cannot do that.
#
# Postmark, Amazon SES and Resend all speak plain SMTP, so nothing in the code
# changes — only these four values. The key is scoped to one verified sending
# domain, rotates in seconds without touching anyone's personal account, and
# brings delivery and bounce logs, which answer "did the recipient actually get
# it" — a question this monitor cannot otherwise answer.
#
#   Postmark   SMTP_HOST=smtp.postmarkapp.com   SMTP_PORT=587
#   Resend     SMTP_HOST=smtp.resend.com        SMTP_PORT=587
#   SES        SMTP_HOST=email-smtp.<region>.amazonaws.com  SMTP_PORT=587
#
# SMTP_USER and SMTP_PASS are then the provider's key, not a person's login.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Pacifica Stream Monitor <monitor@example.org>"

# ── Alert Recipients (comma-separated) ──────────────
ALERT_EMAILS=admin1@example.com,admin2@example.com

# ── Which stations may send email ───────────────────
# Comma-separated station ids. Leave EMPTY for every station, which is what a
# single-station deployment has always had.
#
# Recipients above are one global list, so every station's alerts reach the same
# inbox. Adding a second station therefore signs the first station's staff up for
# its outages — a GM woken about a transmitter in another city. Until recipients
# are per-station, name the stations whose alerts should actually go out.
#
# Everything is still recorded in full either way. A station that emails nobody
# is not a station nobody is watching.
#
# When exactly one station is named, the weekly roundup covers only that station
# too — otherwise its uptime figure would fold in stations the reader does not run.
ALERT_STATIONS=

# ── CC Recipients (comma-separated, optional) ───────
ALERT_CC=

# ── Dashboard URL (included in alert emails) ────────
DASHBOARD_URL=https://your-monitor-domain.com

# ── Monitor Settings ────────────────────────────────
# Check interval in milliseconds (default: 60000 = 1 minute)
CHECK_INTERVAL_MS=60000

# Number of consecutive failures before alerting (default: 2)
FAILURE_THRESHOLD=2

# Alerts are gated on LISTENER IMPACT, not on probe failure. A confirmed outage
# emails only when Icecast shows the mount actually went away — if Icecast stayed
# reachable and kept serving the mount, nobody lost audio and no email is sent.
#
# Set true to email every confirmed outage regardless, including ones proven
# harmless. Off by default: that behaviour is what buried the real alerts in
# noise. Everything is recorded permanently either way. (default: false)
ALERT_ON_HARMLESS_OUTAGE=false

# Server port (default: 3000)
PORT=3000

# ── Weekly Roundup ──────────────────────────────────
# A scheduled summary of the past 7 days — uptime, outages, listeners cut off
# and listening lost — sent whether or not anything went wrong. It is the only
# message that arrives during a quiet week, which is what makes a quiet week
# distinguishable from a monitor that has silently stopped running.
#
# Set false to disable. (default: true, when SMTP is configured)
WEEKLY_ROUNDUP=true

# Day of week to send: 0=Sunday … 6=Saturday. (default: 1, Monday — the week
# it reports on is complete by then.)
WEEKLY_ROUNDUP_DAY=1

# Hour to send, 24h clock, in STATION_TZ. (default: 9)
WEEKLY_ROUNDUP_HOUR=9

# Who receives it. Falls back to ALERT_EMAILS when unset — set it only if the
# weekly report should go to a wider list than the 3am outage alerts.
# WEEKLY_ROUNDUP_EMAILS=manager@example.com,board@example.com

# Timezone for every human-readable time in emails and for the roundup
# schedule. (default: America/Chicago)
STATION_TZ=America/Chicago

# ── Write volume ────────────────────────────────────
# Both data files are re-serialised and rewritten IN FULL on this interval, so
# disk written per day = (events.json + samples.json) x (86400 / this value).
# At 3 monitored streams that is ~5.8 MB every 60s = ~8.4 GB/day to persist
# roughly 2 MB of new data. Harmless at this scale, wasteful, and it scales
# linearly with the number of streams.
#
# Raising this is the cheapest reduction available. The trade is losing up to
# this much dashboard telemetry if the process dies; alert emails are unaffected
# because they are sent during the check cycle, not at save time.
# (default: 60000 = 1 minute)
SAVE_INTERVAL_MS=60000

# ── Retention ───────────────────────────────────────
# Incidents/events are ALWAYS kept permanently and are never pruned by age.
# This controls only the per-check telemetry behind the uptime bars: raw
# samples are kept this many days, then compacted into hourly summaries that
# are themselves kept forever. (default: 7)
#
# Lowering this is safe for the audience model: the hour-of-day listener profile
# reads rollups as well as raw samples, so listener-loss estimates keep their
# full history. Only the raw-resolution window on the dashboard shrinks.
SAMPLE_RETENTION_DAYS=7

# Where the permanent record is written. MUST be a persistent volume in
# production — otherwise every redeploy wipes the incident history.
# DATA_DIR=/app/data

# ── Admin authentication ────────────────────────────
# Guards the endpoints that CHANGE state or SEND MAIL. Reading stays open, which
# is the dashboard's existing behaviour.
#
# Without this, /api/test-alert would let anyone who finds the URL fire
# station-branded email at arbitrary addresses through your SMTP. Protected
# routes therefore FAIL CLOSED: with no password set they return 503 rather
# than allowing the request through.
#
# Generate the hash:   node scripts/hash-password.js
#
# Store the HASH, not the password. Anyone with hosting-panel access can read a
# plaintext env var — on a screenshare, in a support ticket, or via
# `docker inspect` — and a password reused elsewhere would be burned with it.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Accepted as a fallback and hashed at boot, but logged as a warning. Prefer the
# hash above; do not set both.
# ADMIN_PASSWORD=

# Signs session cookies. MUST be set in production — without it a random one is
# generated at boot and everyone is logged out on every redeploy.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set true to require a login for the dashboard and every read endpoint, not
# just for writing and sending mail. Off by default: the dashboard is meant to be
# openable, and public responses are already projected so they carry no personal
# data. Turn it on if the incident history itself should not be readable by
# anyone holding the URL. (default: false)
REQUIRE_LOGIN_FOR_READ=false

# How long a session lasts before re-login. (default: 12)
SESSION_HOURS=12

# Brute-force protection. This, not the shape of the login form, is what stops
# password guessing. (defaults: 5 attempts, 15 minute lockout)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MIN=15

# ── Station configuration ───────────────────────────
# Station, channel and host configuration now lives in the DATA STORE, not here.
# On the first boot against an empty volume the settings below seed it; after
# that the store is authoritative and changes to STREAMS are IGNORED. This is
# deliberate — an admin panel edits settings while the app runs, and two sources
# of truth produce the permanent bug "I changed it in the hosting panel and
# nothing happened".
#
# Secrets (SMTP_PASS and friends) stay here. They never need a UI, so they never
# conflict.
#
# Set true to overwrite the stored configuration from these values on next boot.
# The escape hatch for a bad seed — otherwise the only fix is wiping the volume,
# which would take the incident history with it.
CONFIG_RESEED=false

# Station identity used when seeding.
STATION_ID=kpft
STATION_NAME=KPFT Houston

# ── Diagnostics ─────────────────────────────────────
# Icecast status endpoint used to correlate failures. Comparing a failing
# mount against this inventory is what distinguishes a source-encoder dropout
# (mount absent, server healthy) from a real server outage.
# How many times to ask Icecast before believing it is unreachable, and the wait
# between asks. Icecast is the witness the alert policy depends on: when the
# status fetch fails, listener impact becomes 'unknown', and 'unknown' emails.
# A single dropped connection to Pacifica costs listeners nothing but used to
# page people — 131 of 170 fetch failures in the production record were
# one-second socket hang-ups. A real outage survives a retry; a hiccup does not.
# Set ATTEMPTS=1 to restore the old alert-on-first-failure behaviour.
ICECAST_STATUS_ATTEMPTS=3
ICECAST_STATUS_RETRY_MS=2000

ICECAST_STATUS_URL=https://streams.pacifica.org:9000/status-json.xsl

# Mount paths belonging to this station. Used to tell a station-wide source
# failure apart from a whole-server failure: if these vanish while other
# stations keep streaming, the fault is local.
# Name for this station's own mounts in operator-facing diagnosis text,
# e.g. "3 other KPFT mount(s) are still connected". (default: "station")
STATION_LABEL=KPFT

SIBLING_MOUNTS=/live_128,/live_64,/HD3,/HD3_128,/HD3_64,/classic_country
