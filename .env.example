# ── SMTP Configuration ──────────────────────────────
# PREFER A SEND-ONLY CREDENTIAL over a mailbox password.
#
# A mailbox account's SMTP password — a Gmail app password, say — usually grants
# READ access to that mailbox as well as the ability to send. If it leaks, an
# attacker does not merely send mail as the station; they may read the station's
# mail. A transactional provider's API key cannot do that.
#
# Postmark, Amazon SES and Resend all speak plain SMTP, so nothing in the code
# changes — only these four values. The key is scoped to one verified sending
# domain, rotates in seconds without touching anyone's personal account, and
# brings delivery and bounce logs, which answer "did the recipient actually get
# it" — a question this monitor cannot otherwise answer.
#
#   Postmark   SMTP_HOST=smtp.postmarkapp.com   SMTP_PORT=587
#   Resend     SMTP_HOST=smtp.resend.com        SMTP_PORT=587
#   SES        SMTP_HOST=email-smtp.<region>.amazonaws.com  SMTP_PORT=587
#
# SMTP_USER and SMTP_PASS are then the provider's key, not a person's login.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Pacifica Stream Monitor <monitor@example.org>"

# ── Alert Recipients (comma-separated) ──────────────
# The FALLBACK list. Each station can have its own recipients, set with the
# Alerts button on its card in /admin.html and stored in the data volume. A
# station with none of its own falls back to these, so a single-station
# deployment needs nothing more than this line.
ALERT_EMAILS=admin1@example.com,admin2@example.com

# ── Sending from a development machine ──────────────
# Email is suppressed unless this process is a deployed instance — the image
# sets MONITOR_CONTAINER, and a running container is recognised by /.dockerenv
# even on an older build. You do NOT need to set anything here in production.
#
# This exists because the same .env is copied to a laptop, credentials and
# recipient list included. Running `node server.js` from a checkout once mailed
# a station's General Manager three times about a test fixture. Recipients
# cannot tell a development alert from a real outage.
#
# Set this ONLY to test the mail path deliberately. It really does send to
# ALERT_EMAILS above.
# ALERTS_FORCE=true

# ── Which stations may send email ───────────────────
# Comma-separated station ids. Leave EMPTY for every station, which is what a
# single-station deployment has always had.
#
# Recipients above are one global list, so every station's alerts reach the same
# inbox. Adding a second station therefore signs the first station's staff up for
# its outages — a GM woken about a transmitter in another city. Until recipients
# are per-station, name the stations whose alerts should actually go out.
#
# Everything is still recorded in full either way. A station that emails nobody
# is not a station nobody is watching.
#
# When exactly one station is named, the weekly roundup covers only that station
# too — otherwise its uptime figure would fold in stations the reader does not run.
#
# This is the default for stations NOT configured in /admin.html. A station given
# its own recipients there answers for itself and overrides this.
ALERT_STATIONS=

# ── CC Recipients (comma-separated, optional) ───────
# Copied on every alert AND on the weekly roundup. Typically whoever runs the
# monitor: the roundup is what tells them it is still running at all.
# The per-station panel edits a single list and does not offer a CC field —
# To/CC separates people, and in an automated alert it separates nothing.
ALERT_CC=

# ── Dashboard URL (included in alert emails) ────────
DASHBOARD_URL=https://your-monitor-domain.com

# ── Monitor Settings ────────────────────────────────
# Check interval in milliseconds (default: 60000 = 1 minute)
CHECK_INTERVAL_MS=60000

# Number of consecutive failures before alerting (default: 2)
FAILURE_THRESHOLD=2

# Alerts are gated on LISTENER IMPACT, not on probe failure. A confirmed outage
# emails only when Icecast shows the mount actually went away — if Icecast stayed
# reachable and kept serving the mount, nobody lost audio and no email is sent.
#
# Set true to email every confirmed outage regardless, including ones proven
# harmless. Off by default: that behaviour is what buried the real alerts in
# noise. Everything is recorded permanently either way. (default: false)
ALERT_ON_HARMLESS_OUTAGE=false

# ── Repeated outages ────────────────────────────────────────────────────────
# The gate above judges ONE outage, and judges it correctly — which is why a
# flapping source encoder walked straight through it fourteen times in an hour on
# 2026-09-02, every alert true and the set of them worthless.
#
# A second confirmed failure on the same stream inside STORM_WINDOW_MS declares a
# "storm": one further email marking the stream UNSTABLE and saying that alerts
# are paused, then silence for that stream, then a single summary once it has
# stayed healthy for STORM_CLEAR_AFTER_MS. Every flap in between is still
# recorded in full, and each event says why it was not emailed.
#
# The FIRST outage is never delayed. A hold-down would quiet the inbox too, by
# taxing the one alert that matters; this pays with the sixth alert instead.
#
# Outages and dead air share one storm per stream: an encoder alternating between
# dropping its connection and feeding silence is one fault with two symptoms.
#
# Set STORM_WINDOW_MS=0 to disable this and alert on every episode. (defaults:
# 2 outages, 45 min window, 30 min of health to clear)
STORM_OUTAGE_COUNT=2
STORM_WINDOW_MS=2700000
STORM_CLEAR_AFTER_MS=1800000

# Server port (default: 3000)
PORT=3000

# ── Weekly Roundup ──────────────────────────────────
# A scheduled summary of the past 7 days — uptime, outages, listeners cut off
# and listening lost — sent whether or not anything went wrong. It is the only
# message that arrives during a quiet week, which is what makes a quiet week
# distinguishable from a monitor that has silently stopped running.
#
# ONE REPORT PER STATION, addressed to that station's own recipient list and
# scoped to its own channels. A station with no recipients, or with alerts
# switched off, gets none.
#
# Set false to disable. (default: true, when SMTP is configured)
WEEKLY_ROUNDUP=true

# Day of week to send: 0=Sunday … 6=Saturday. (default: 1, Monday — the week
# it reports on is complete by then.)
WEEKLY_ROUNDUP_DAY=1

# Hour to send, 24h clock, read in EACH STATION'S OWN timezone — so a 9am
# report arrives at 9am where the person reading it lives. (default: 9)
WEEKLY_ROUNDUP_HOUR=9

# Fallback timezone for a station that has none of its own, and the timezone
# for human-readable times in emails. (default: America/Chicago)
STATION_TZ=America/Chicago

# ── Write volume ────────────────────────────────────
# Both data files are re-serialised and rewritten IN FULL on this interval, so
# disk written per day = (events.json + samples.json) x (86400 / this value).
# At 3 monitored streams that is ~5.8 MB every 60s = ~8.4 GB/day to persist
# roughly 2 MB of new data. Harmless at this scale, wasteful, and it scales
# linearly with the number of streams.
#
# Raising this is the cheapest reduction available. The trade is losing up to
# this much dashboard telemetry if the process dies; alert emails are unaffected
# because they are sent during the check cycle, not at save time.
# (default: 60000 = 1 minute)
SAVE_INTERVAL_MS=60000

# ── Retention ───────────────────────────────────────
# Incidents/events are ALWAYS kept permanently and are never pruned by age.
# This controls only the per-check telemetry behind the uptime bars: raw
# samples are kept this many days, then compacted into hourly summaries that
# are themselves kept forever. (default: 7)
#
# Lowering this is safe for the audience model: the hour-of-day listener profile
# reads rollups as well as raw samples, so listener-loss estimates keep their
# full history. Only the raw-resolution window on the dashboard shrinks.
# ── Audience reach (cume) retention ──────────────────────────
# Distinct-device records, tiered like samples: full resolution recently,
# coarser as it ages, and NEVER DELETED unless you ask.
#
# Cume is the number a board, a funder and a CPB return actually ask for, and
# every one of those questions spans years. So the month tier is permanent by
# default: what ages out is RESOLUTION, not the listener. After the day tier
# expires you can no longer ask "reach for 3-17 March 2024", but "March 2024"
# and "2024 vs 2025" stay exactly answerable for ever.
#
# Cost, measured: 35 bytes per device row. About 4.8 MB/year for a five-station
# network, ~28 MB/year for 33 affiliates. Storage is not the constraint; RAM is,
# which is what the SQLite migration is for.
DEVICE_HOUR_RETENTION_H=48        # hourly buckets — exact cume for ANY window
DEVICE_DAY_RETENTION_DAYS=90      # then daily buckets — exact for any day range
DEVICE_MONTH_RETENTION_MONTHS=0   # then monthly, kept FOR EVER. 0 = never delete.
                                  # Set a number only if a deployment has a legal
                                  # or disk reason to forget. It cannot happen by
                                  # accident.

SAMPLE_RETENTION_DAYS=7

# Where the permanent record is written. MUST be a persistent volume in
# production — otherwise every redeploy wipes the incident history.
# DATA_DIR=/app/data

# ── Admin authentication ────────────────────────────
# Guards the endpoints that CHANGE state or SEND MAIL. Reading stays open, which
# is the dashboard's existing behaviour.
#
# Without this, /api/test-alert would let anyone who finds the URL fire
# station-branded email at arbitrary addresses through your SMTP. Protected
# routes therefore FAIL CLOSED: with no password set they return 503 rather
# than allowing the request through.
#
# Generate the hash:   node scripts/hash-password.js
#
# Store the HASH, not the password. Anyone with hosting-panel access can read a
# plaintext env var — on a screenshare, in a support ticket, or via
# `docker inspect` — and a password reused elsewhere would be burned with it.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Accepted as a fallback and hashed at boot, but logged as a warning. Prefer the
# hash above; do not set both.
# ADMIN_PASSWORD=

# Signs session cookies. MUST be set in production — without it a random one is
# generated at boot and everyone is logged out on every redeploy.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set true to require a login for the dashboard and every read endpoint, not
# just for writing and sending mail. Off by default: the dashboard is meant to be
# openable, and public responses are already projected so they carry no personal
# data. Turn it on if the incident history itself should not be readable by
# anyone holding the URL. (default: false)
REQUIRE_LOGIN_FOR_READ=false

# How long a session lasts before re-login. (default: 12)
SESSION_HOURS=12

# Brute-force protection. This, not the shape of the login form, is what stops
# password guessing. (defaults: 5 attempts, 15 minute lockout)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MIN=15

# ── Station configuration ───────────────────────────
# Station, channel and host configuration now lives in the DATA STORE, not here.
# On the first boot against an empty volume the settings below seed it; after
# that the store is authoritative and changes to STREAMS are IGNORED. This is
# deliberate — an admin panel edits settings while the app runs, and two sources
# of truth produce the permanent bug "I changed it in the hosting panel and
# nothing happened".
#
# Secrets (SMTP_PASS and friends) stay here. They never need a UI, so they never
# conflict.
#
# Set true to overwrite the stored configuration from these values on next boot.
# The escape hatch for a bad seed — otherwise the only fix is wiping the volume,
# which would take the incident history with it.
CONFIG_RESEED=false

# Station identity used when seeding.
STATION_ID=kpft
STATION_NAME=KPFT Houston

# ── Diagnostics ─────────────────────────────────────
# Icecast status endpoint used to correlate failures. Comparing a failing
# mount against this inventory is what distinguishes a source-encoder dropout
# (mount absent, server healthy) from a real server outage.
# How many times to ask Icecast before believing it is unreachable, and the wait
# between asks. Icecast is the witness the alert policy depends on: when the
# status fetch fails, listener impact becomes 'unknown', and 'unknown' emails.
# A single dropped connection to Pacifica costs listeners nothing but used to
# page people — 131 of 170 fetch failures in the production record were
# one-second socket hang-ups. A real outage survives a retry; a hiccup does not.
# Set ATTEMPTS=1 to restore the old alert-on-first-failure behaviour.
ICECAST_STATUS_ATTEMPTS=3
ICECAST_STATUS_RETRY_MS=2000

ICECAST_STATUS_URL=https://streams.pacifica.org:9000/status-json.xsl

# ── Icecast ADMIN credential ─────────────────────────────────
# Unlocks /admin/stats and /admin/listclients: source IP and encoder identity,
# per-mount slow-listener counts, real session length, device breakdown.
# Scoped in docs/ADMIN-ACCESS-SCOPE.md; sequenced as Phase 5 in docs/PHASE-PLAN.md.
#
# WHERE THESE GO: production sets them as environment variables in the Coolify
# panel; local testing puts them in .env. Same as every other secret here.
#
# Optional, and the tool is complete without them — an affiliate pasting a
# stream URL has no admin password for a server somebody else runs. Nothing may
# break for not having one. Per docs/AUDIENCE-ROADMAP.md §4.1 these belong to
# the HOST, not the station, because five stations share one Icecast server;
# env is how a credential is supplied until per-host entry exists in the panel,
# following the same "env seeds, the store owns" rule as STREAMS and
# ALERT_EMAILS.
#
# Store the ADMIN password only. A source/relay password lets a client connect
# AS a source and take over a mount, including another station's. This tool has
# no read-only use for one and must not hold one.
#
# ⚠ QUOTE THE PASSWORD IF IT CONTAINS '#'. dotenv treats an unquoted '#' as the
# start of a comment even with no space before it, so
#     ICECAST_ADMIN_PASSWORD=s3cret#word
# silently becomes "s3cret" and you get a 401 against a password that looks
# perfectly correct in the file. Verified against dotenv 16 in this project.
# Quoting fixes it. This applies to SMTP_PASS and every other secret here too.
# In the COOLIFY UI, type the raw value with NO quotes — that is a form field,
# not a parsed file, so quotes would become part of the password.
# OPTIONAL — normally leave this empty.
#
# The host is derived automatically: the server carrying the most monitored
# channels, which is the one this monitor was set up against. A hostname is not
# a secret (streams.pacifica.org:9000 is in the README and is the address
# listeners connect to), so requiring it to be retyped here bought nothing and
# silently cost the first production deploy its entire audience collection.
#
# What still holds: the credential is sent to that ONE host and no other.
# Several monitored stations run their own Icecast — KPFA is on Pacifica's
# shared server AND its own — so a credential applied to "every monitored host"
# would post one organisation's admin password to another's machine.
#
# Set this ONLY if the credential belongs to a server that is NOT the one
# carrying most of your channels.
ICECAST_ADMIN_HOST=
ICECAST_ADMIN_USER=
ICECAST_ADMIN_PASSWORD=

# ── Geo / network databases — OPTIONAL, and supplied by you ──────────────────
# Local MMDB files. Both are optional; with neither set the app degrades to an
# honest "not available" and never guesses.
#
# WHY THESE ARE PATHS AND NOT A LICENCE KEY. A LOCAL DATABASE, NEVER A LOOKUP
# API: an API means sending every listener's IP address to a third party, one
# request per listener, for as long as the product runs. Nothing is bundled and
# nothing is downloaded, because the licences differ per vendor and a deployer
# supplying their own file is the only arrangement that keeps every option open.
#
# TWO VENDORS, ONE FORMAT — switching is an env path, not a code change:
#
#   DB-IP Lite      https://db-ip.com/db/lite.php
#                   CC BY 4.0. NO ACCOUNT, no licence key, direct download,
#                   updated monthly. Requires a visible credit with a link back
#                   to db-ip.com on any page showing the data — the app renders
#                   this for you from the file it actually loaded.
#
#   MaxMind GeoLite2  https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
#                   Free of charge, but needs an account, a licence key and a
#                   EULA that obliges you to keep the data current.
#
# WHICH TO USE. For ASN they are equivalent — an AS number comes from the public
# routing table. For CITY, MaxMind is materially better at US state level, which
# is the resolution the in-market question needs; DB-IP Lite is weakest exactly
# there. So: start with DB-IP ASN Lite (no signup), and revisit the city
# database when the map is built.
#
# NEITHER CARRIES A HOSTING FLAG. `is_hosting_provider` belongs to MaxMind's
# PAID Anonymous IP database. Datacenter detection here is a match against AS
# organisation NAMES, and is labelled as the heuristic it is.
GEOIP_ASN_DB=
GEOIP_CITY_DB=

# ── GeoLite2 auto-download (the CITY database) ───────────────────────────────
# Set this and the app downloads GeoLite2 City onto the DATA VOLUME at startup
# and keeps it fresh. This is how the map gets its data.
#
# WHY THE CITY DATABASE IS NOT BAKED INTO THE IMAGE like the ASN one. Two
# reasons, and both matter:
#
#   LICENCE. MaxMind's GeoLite2 EULA restricts redistributing the database.
#   DB-IP's CC BY licence permits it, which is why the ASN database can ride in
#   the image and this one cannot. Each deployment downloads its own copy under
#   its own key, so nothing is ever redistributed by us.
#
#   THE FREE ALTERNATIVE CANNOT DO THE JOB. Verified against the real files on
#   2026-09-02: DB-IP City Lite ships NO `accuracy_radius` field at all. That
#   field is the only thing that tells a real place apart from a region
#   CENTROID — the fallback every database returns when it cannot resolve an
#   address, which manufactures a cluster of listeners where nobody lives. With
#   DB-IP installed the app reports countries correctly and withholds every
#   state on purpose, saying so on the page.
#
# Free, and free of charge: sign in at maxmind.com, "Manage license keys",
# generate one. The paid product is GeoIP2; GeoLite2 costs nothing.
MAXMIND_LICENSE_KEY=

# How old the downloaded database may get before a refresh is attempted.
# Default 14 days. MaxMind rebuilds twice a week; these figures move slowly and
# a station is not served by re-downloading 60 MB daily.
GEOIP_MAX_AGE_MS=1209600000

# ── The station's own US state ───────────────────────────────────────────────
# Turns the state distribution into the figure a manager actually asks for:
# how much of the audience is OUTSIDE the broadcast footprint.
#
# IT IS A STATE, NOT A SIGNAL AREA, and the page says so. KPFT's licence covers
# Greater Houston; this counts everyone in Texas, so a listener in Dallas reads
# as in-market. The figure therefore OVERSTATES the audience inside the
# footprint. Metro resolution is not published, so naming the state is the
# honest version of the question.
#
# Leave empty and the map still draws; only the in-market headline is withheld
# rather than guessed from the largest state.
STATION_REGION=

# A city record wider than this is a REGION CENTROID, not a place, and is
# published as a country with no state. This gate is the thing standing between
# the product and MaxMind's own documented failure case: a Kansas farm that
# received years of harassment because unresolvable US addresses resolved to its
# coordinates. Raising it does not improve accuracy; it manufactures findings.
GEOIP_MAX_ACCURACY_RADIUS_KM=200

# Mount paths belonging to this station. Used to tell a station-wide source
# failure apart from a whole-server failure: if these vanish while other
# stations keep streaming, the fault is local.
# Name for this station's own mounts in operator-facing diagnosis text,
# e.g. "3 other KPFT mount(s) are still connected". (default: "station")
STATION_LABEL=KPFT

SIBLING_MOUNTS=/live_128,/live_64,/HD3,/HD3_128,/HD3_64,/classic_country
